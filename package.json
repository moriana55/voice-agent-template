{
  "name": "voiceops-studio",
  "version": "0.1.0",
  "description": "Multilingual voice-operations prototype with live Fish Audio speech, structured call state, provider fallback, and Twilio workflows.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint client/src server shared test script --max-warnings=0",
    "build": "tsx script/build.ts",
    "start": "node dist/index.cjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke:http": "node script/http-smoke.mjs",
    "smoke:load": "node script/load-smoke.mjs",
    "smoke:live": "node script/live-smoke.mjs",
    "launch:gate": "node script/launch-gate.mjs",
    "backup": "node script/encrypted-backup.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fish-audio": "^0.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "openai": "^6.7.0",
    "twilio": "^6.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "wouter": "^3.10.0"
  }
}
