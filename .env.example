OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_REFERENCE_ID=

DEMO_MODE=false
PORT=5177

# Doğrulanmış işletme bilgisi; model yalnızca burada verilen şirket bilgisini kullanır.
BUSINESS_CONTEXT="Şirket adı, çalışma saatleri, hizmetler ve aktarım kuralları"

# Güvenlik ve veri saklama
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5177
TURN_RATE_LIMIT=20
ADMIN_API_KEY=
DATA_DIR=./data
RECORD_STORAGE=enabled
DATA_ENCRYPTION_KEY=
RECORD_RETENTION_DAYS=30

# Tamamlanan lead/randevu aktarımı
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CALENDAR_WEBHOOK_URL=
CALENDAR_WEBHOOK_TOKEN=

# Twilio Programmable Voice
PUBLIC_BASE_URL=https://voice.example.com
TWILIO_AUTH_TOKEN=
# Yalnızca yerel testte kullanılabilir; production ortamında etkisizdir.
TWILIO_SKIP_SIGNATURE=false
