OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
# Ortak yedek ses. Dile özel kimlik varsa aşağıdaki değişkenler önceliklidir.
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_REFERENCE_ID_EN=
FISH_AUDIO_REFERENCE_ID_TR=
FISH_AUDIO_REFERENCE_ID_ES=
FISH_AUDIO_REFERENCE_ID_DE=
FISH_AUDIO_REFERENCE_ID_FR=
FISH_AUDIO_REFERENCE_ID_IT=
FISH_AUDIO_REFERENCE_ID_PT=
FISH_AUDIO_REFERENCE_ID_NL=
FISH_AUDIO_REFERENCE_ID_PL=
FISH_AUDIO_REFERENCE_ID_RU=

# Telefon hattı ve API isteği dil belirtmezse kullanılacak varsayılan dil.
AGENT_LANG=en

# Müşteriye özel beyaz etiket ve fiyat paketi
CUSTOMER_MODE=false
PUBLIC_PRODUCT_NAME=VoiceOps Studio
PUBLIC_AGENT_NAME=Nova
PUBLIC_BUSINESS_NAME=VoiceOps Studio
PUBLIC_TAGLINE=Global voice operations
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_URL=/#/privacy
SHOW_PORTFOLIO_ATTRIBUTION=true
PLAN_NAME=Managed Voice
PLAN_INCLUDED_MINUTES=300
PLAN_OVERAGE_TRY_PER_MINUTE=12
# 0 kotayı kapatır. Ücretli müşteri kurulumunda mutlaka pozitif değer kullanın.
USAGE_HARD_LIMIT_MINUTES=0
USAGE_HASH_KEY=

DEMO_MODE=false
PORT=5177

# Doğrulanmış işletme bilgisi; model yalnızca burada verilen şirket bilgisini kullanır.
BUSINESS_CONTEXT="Şirket adı, çalışma saatleri, hizmetler ve aktarım kuralları"

# Güvenlik ve veri saklama
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5177
WEB_REPLICA_COUNT=1
TURN_RATE_LIMIT=20
TURN_MAX_CONCURRENCY=4
ADMIN_API_KEY=
DATA_DIR=./data
RECORD_STORAGE=enabled
DATA_ENCRYPTION_KEY=
RECORD_RETENTION_DAYS=30
RECORD_PRUNE_INTERVAL_MS=21600000
GRACEFUL_SHUTDOWN_MS=9000
EXPOSE_PROVIDER_STATUS=false

# Tamamlanan lead/randevu aktarımı
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CALENDAR_WEBHOOK_URL=
CALENDAR_WEBHOOK_TOKEN=
# Production'da generic webhook URL'lerinin exact hostname allowlist'i.
INTEGRATION_WEBHOOK_ALLOWED_HOSTS=

# Doğrudan Google Calendar OAuth bağlantısı
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
BUSINESS_TIME_ZONE=Europe/Istanbul
APPOINTMENT_DURATION_MINUTES=30

# HubSpot private app; crm.objects.contacts.read/write izinleri gerekir.
HUBSPOT_ACCESS_TOKEN=

# Stripe abonelik Checkout ve doğrulanmış webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Twilio Programmable Voice
PUBLIC_BASE_URL=https://voice.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Telefon kayıtları, işletmenin hukuki dayanağı doğrulanana kadar kapalıdır.
TELEPHONY_RECORD_STORAGE=disabled
# Yalnızca yerel testte kullanılabilir; production ortamında etkisizdir.
TWILIO_SKIP_SIGNATURE=false
